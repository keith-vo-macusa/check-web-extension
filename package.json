{
    "name": "check-web-extension",
    "version": "1.1.9",
    "description": "Chrome Extension hỗ trợ tester kiểm tra website, cho phép chọn vùng lỗi và thêm comment",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "build:clean": "rimraf dist",
        "prebuild": "npm run build:clean",
        "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
        "check:env": "node scripts/check-env.mjs",
        "check": "npm run check:env && npm run check:undef && npm run format:check && npm test",
        "check:types": "tsc --noEmit -p jsconfig.json",
        "test": "node --test \"test/*.test.js\"",
        "check:undef": "node scripts/check-undefined.mjs"
    },
    "keywords": [
        "chrome-extension",
        "testing",
        "website-testing"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "clean-css": "^5.3.3",
        "rimraf": "^6.1.3",
        "terser": "^5.46.1",
        "vite": "^8.0.9",
        "prettier": "^3.4.2",
        "@types/chrome": "^0.0.287",
        "typescript": "^5.7.2"
    }
}
